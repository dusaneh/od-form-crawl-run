{
  "name": "formweave-control-plane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "local": "node local/start.mjs",
    "local:api": "node local/server.mjs",
    "local:web": "vinext dev --hostname 127.0.0.1 --port 3000",
    "local:import-report": "node local/import-report.mjs",
    "fixtures": "node test-sites/server.mjs",
    "crawl:harness": "node test-sites/harness.mjs",
    "crawl:harness:headed": "node test-sites/harness.mjs --headed",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:crawler": "node --test tests/playwright-crawl.test.mjs",
    "test:api": "node --test tests/local-api.test.mjs",
    "test:ui": "node --test tests/ui-control-plane.test.mjs",
    "test:openai": "node --test tests/openai-analysis.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
