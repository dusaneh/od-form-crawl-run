{
  "openapi": "3.1.0",
  "info": {
    "title": "FormWeave — Kick Off Crawl",
    "version": "1.2.0",
    "description": "Starts one asynchronous, single-form crawl and returns the run ID needed by the crawl-status API. The LLM may navigate from the supplied page to one resource-access form; heuristic related-page discovery and alternate-form crawling are disabled. The caller explicitly chooses whether the synthetic crawl stops at the terminal boundary or submits the form."
  },
  "servers": [
    {
      "url": "https://onedeg-intake-form-staging.herokuapp.com",
      "description": "One Degree staging"
    },
    {
      "url": "http://127.0.0.1:8787",
      "description": "Local developer API"
    }
  ],
  "paths": {
    "/api/runs": {
      "post": {
        "operationId": "startCrawl",
        "summary": "Kick off a crawl",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartCrawlRequest"
              },
              "example": {
                "urls": [
                  "https://example.org/application"
                ],
                "name": "Example crawl",
                "mode": "probe",
                "submit": false,
                "browserMode": "headless",
                "allowLocalTargets": false,
                "componentAuthorities": {
                  "consent": false,
                  "signature": false,
                  "upload": false,
                  "acknowledgement": false,
                  "reviewConfirmation": false
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Accepted. Save run.id and pass it to GET /api/runs/{runId}.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartCrawlResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StartCrawlRequest": {
        "type": "object",
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exactly one starting HTTP or HTTPS URL. From that rendered page, the LLM may select one observed action to reach one OneDegree-relevant resource-access form. Alternate forms and unrelated pages are outside the crawl."
          },
          "name": {
            "type": "string",
            "description": "Optional display name."
          },
          "mode": {
            "type": "string",
            "enum": [
              "probe",
              "fixture_submit"
            ],
            "default": "probe",
            "deprecated": true,
            "description": "Compatibility field. Send probe and use the submit boolean to choose the terminal boundary. Legacy fixture_submit is equivalent to submit=true."
          },
          "submit": {
            "type": "boolean",
            "default": false,
            "description": "false traverses with synthetic values and blocks the LLM-authored terminal action. true explicitly authorizes that terminal action and post-submit verification during this crawl. It applies equally to public targets and explicitly enabled localhost targets; it does not authorize CAPTCHA solving, login credentials, or payment."
          },
          "browserMode": {
            "type": "string",
            "enum": [
              "headless",
              "headful"
            ],
            "default": "headless",
            "description": "headful opens visible Chromium only when FormWeave runs on the operator's workstation. Hosted deployments are headless-only and reject headful."
          },
          "allowLocalTargets": {
            "type": "boolean",
            "default": false,
            "description": "Allows loopback targets only when FormWeave is itself running locally. Hosted deployments reject this flag because localhost would refer to the remote worker. Other private-network targets remain blocked."
          },
          "componentAuthorities": {
            "type": "object",
            "description": "Fresh per-crawl permission for the LLM-authored script to model these component types with synthetic values. These permissions apply to public and local targets and are independent of the terminal submit choice.",
            "properties": {
              "acknowledgement": { "type": "boolean", "default": false },
              "consent": { "type": "boolean", "default": false },
              "reviewConfirmation": { "type": "boolean", "default": false },
              "signature": { "type": "boolean", "default": false },
              "upload": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          },
          "fixtureAuthorities": {
            "type": "object",
            "deprecated": true,
            "description": "Legacy alias of componentAuthorities.",
            "properties": {
              "acknowledgement": { "type": "boolean", "default": false },
              "consent": { "type": "boolean", "default": false },
              "reviewConfirmation": { "type": "boolean", "default": false },
              "signature": { "type": "boolean", "default": false },
              "upload": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "StartCrawlResponse": {
        "type": "object",
        "required": [
          "run"
        ],
        "properties": {
          "run": {
            "$ref": "#/components/schemas/QueuedRun"
          }
        }
      },
      "QueuedRun": {
        "type": "object",
        "required": [
          "id",
          "status",
          "progress"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Server-generated crawl/run ID."
          },
          "crawlId": {
            "type": "string",
            "description": "Alias of id."
          },
          "status": {
            "type": "string",
            "example": "running"
          },
          "stage": {
            "type": "string"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": true
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid URL, mode, or target boundary.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Conflict": {
        "description": "A required generated script or authority is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Bearer token missing, invalid, expired, or revoked.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Server-side FormWeave API token. Never place it in a browser bundle, URL, or log."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
