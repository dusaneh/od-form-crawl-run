OPENAI_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SEMANTIC_MODEL=gpt-5.4-mini
FORMWEAVE_API_HOST=127.0.0.1
FORMWEAVE_API_PORT=8787
FORMWEAVE_DATA_DIR=data
# When set, PostgreSQL becomes the durable application store. Files beneath
# FORMWEAVE_CACHE_DIR are disposable runtime materializations for Playwright.
POSTGRES_URI=
# Remote hosts use verified TLS by default. Set POSTGRES_SSL=require only for a
# provider whose certificate chain cannot be verified by the local runtime.
POSTGRES_SSL=
FORMWEAVE_STORAGE=
FORMWEAVE_CACHE_DIR=.formweave-cache
# Optional browser/model timing overrides in milliseconds.
FORMWEAVE_RENDER_SETTLE_MS=700
FORMWEAVE_HEADFUL_PAUSE_MS=1200
FORMWEAVE_OPENAI_TIMEOUT_MS=120000
